{
  "name": "mkpdf-cross",
  "productName": "MK PDF",
  "version": "1.3.9",
  "description": "MK PDF for Windows and Android",
  "author": "MK PDF",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "test": "node --import tsx --test test/*.test.ts",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "android:sync": "npm run build && cap sync android",
    "prebuild": "node scripts/copy-assets.mjs",
    "predev": "node scripts/copy-assets.mjs",
    "build:core": "esbuild src/core/mac-entry.ts --bundle --format=iife --platform=neutral --main-fields=module,main --target=es2020 --minify --legal-comments=none --outfile=dist-core/core.js"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "lucide-preact": "^1.61.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "preact": "^11.0.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.mkoussa.mkpdf",
    "productName": "MK PDF",
    "copyright": "MK PDF",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-1024.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MK PDF",
      "deleteAppDataOnUninstall": false,
      "artifactName": "MK-PDF-${version}-win-x64.exe"
    },
    "portable": {
      "artifactName": "MK-PDF-${version}-portable.exe",
      "requestExecutionLevel": "user"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Editor"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "mohamdbeam-star",
        "repo": "MK-PDF",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamdbeam-star/MK-PDF.git"
  },
  "dependencies": {
    "@capacitor/ios": "^8.6.0"
  }
}
